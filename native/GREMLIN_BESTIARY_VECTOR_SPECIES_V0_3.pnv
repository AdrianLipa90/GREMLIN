PNV 1
EPISTEMIC CHYBA
MODE INTERNAL_EXECUTION

# GREMLIN Bestiary vector-species execution v0.3.
# The orbital scheduler chooses service cadence. v0.3 groups admitted work by
# species and executes bounded same-operator lanes instead of per-item spawn.

OP VECTOR.TASK SOURCE gremlin.bestiary.orbit.admitted
OP VECTOR.TASK.IDENTITY IDENTITY content_addressed_candidate
OP VECTOR.ROUTE SOURCE octopus.semantic_route_mask
OP VECTOR.ROUTE.IDENTITY IDENTITY bounded_route_mask
OP VECTOR.MASS SOURCE exact_semantic_mass_units
OP VECTOR.MASS.IDENTITY IDENTITY verified_mass_binding
OP VECTOR.ORBIT SOURCE scheduler_orbit_radius
OP VECTOR.FREQUENCY TRANSFORM VECTOR.MASS VECTOR.ORBIT
OP VECTOR.SPECIES TRANSFORM VECTOR.ROUTE group_by_specialist_operator
OP VECTOR.LANES TRANSFORM VECTOR.SPECIES bounded_vector_lane_width
OP VECTOR.BATCH COMPOSITION VECTOR.FREQUENCY VECTOR.LANES
OP VECTOR.ORDER ORDER VECTOR.BATCH task_arrival_order
OP VECTOR.EXECUTE TRANSFORM VECTOR.ORDER same_operator_vector_execution
OP VECTOR.JOIN ORDER VECTOR.EXECUTE lineage_complete
OP BELZEBUB.VECTOR TRANSFORM VECTOR.JOIN bounded_heavy_synthesis_batch
OP GREMLIN.VECTOR.AGGREGATE COMPOSITION VECTOR.JOIN BELZEBUB.VECTOR
OP GREMLIN.VECTOR.RETURN RETURN GREMLIN.VECTOR.AGGREGATE

ASSERT VECTOR.TASK.IDENTITY
ASSERT VECTOR.ROUTE.IDENTITY
ASSERT VECTOR.MASS.IDENTITY
ASSERT VECTOR.LANES
ASSERT VECTOR.JOIN
EMIT GREMLIN.VECTOR.RETURN

# EXECUTION_MODEL SPECIES_RESIDENT_VECTOR_LANES
# SCHEDULER_INPUT MASS_ORBIT_FREQUENCY
# ROUTER OCTOPUS
# SPAWN_PER_ITEM FALSE
# GROUP_BY_OPERATOR TRUE
# STRUCTURE_OF_ARRAYS_PREFERRED TRUE
# LANE_WIDTH_BOUNDED TRUE
# HEAVY_OUTER_ORBIT_LARGER_BATCH TRUE
# FAST_INNER_ORBIT_SMALL_LATENCY_BATCH TRUE
# ORDER_CAUSAL TRUE
# LINEAGE_REQUIRED TRUE
# OUTPUT_STATUS CANDIDATE
# CANON_ALLOWED FALSE
# CONTENT_ADDRESSED TRUE
# KAPPA ln(2)/(24*pi)
# NEW_PNV_OPCODES 0
