PNV 1
EPISTEMIC CHYBA
MODE INTERNAL_EXECUTION

# GREMLIN persistent-memory contract v0.4.
# Local tool CURRENT pointers are authoritative for their namespaces.
# GREMLIN SUPER_CURRENT is the verified aggregate head.

OP PM.ROOT SOURCE /dev/shm/ciel_noema/gremlin
OP PM.GREMLIN.CURRENT SOURCE /dev/shm/ciel_noema/gremlin/meta/SUPER_CURRENT.json
OP PM.OCTOPUS.CURRENT SOURCE /dev/shm/ciel_noema/gremlin/tools/octopus/meta/CURRENT.json
OP PM.BELZEBUB.CURRENT SOURCE /dev/shm/ciel_noema/gremlin/tools/belzebub/meta/CURRENT.json

OP PM.OCTOPUS.IDENTITY IDENTITY verified_object_receipt_current
OP PM.BELZEBUB.IDENTITY IDENTITY verified_object_receipt_current
OP PM.HEADS.ORDER ORDER PM.OCTOPUS.IDENTITY PM.BELZEBUB.IDENTITY
OP PM.SUPER.TRANSFORM TRANSFORM PM.GREMLIN.CURRENT verified_composite_descendant
OP PM.SUPER.COMPOSE COMPOSITION PM.HEADS.ORDER PM.SUPER.TRANSFORM
OP PM.READY.RETURN RETURN PM.SUPER.COMPOSE

ASSERT PM.OCTOPUS.IDENTITY
ASSERT PM.BELZEBUB.IDENTITY
EMIT PM.READY.RETURN

# GREMLIN_PROTOCOL OBJECT->RECEIPT->SUPER_CURRENT
# TOOL_PROTOCOL OBJECT->RECEIPT->CURRENT
# CURRENT_POINTERS 2
# SUPER_CURRENT_POINTERS 1
# OCTOPUS_CURRENT_AUTHORITATIVE TRUE
# BELZEBUB_CURRENT_AUTHORITATIVE TRUE
# ROOT_SUPER_CURRENT_AUTHORITATIVE TRUE
# TOOL_WRITES_LOCAL_ONLY TRUE
# ROOT_AGGREGATES_VERIFIED_TOOL_HEADS TRUE
# PARENT_VERIFICATION REQUIRED
# RECEIPT_VERIFICATION REQUIRED
# CONTENT_ADDRESSING SHA256_CANONICAL_PAYLOAD
# EPOCH MONOTONIC
# TICK_REQUIRED FALSE
# TRANSITION_MODE EVENT_DRIVEN
# LIVE_SURFACE /dev/shm/ciel_noema
# LIBRARY_IS_OPERATING_STATE FALSE
# STATIC_RUNTIME_FALLBACK FALSE
# LAST_WRITER_WINS FALSE
# MISSING_PARENT FAIL_CLOSED
# CORRUPT_CURRENT FAIL_CLOSED
# NEW_PNV_OPCODES 0
