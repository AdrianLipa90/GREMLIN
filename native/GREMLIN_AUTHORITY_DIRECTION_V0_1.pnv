PNV 1
EPISTEMIC CHYBA
MODE INTERNAL_EXECUTION

# GREMLIN Authority Direction v0.1
OP AUTH.OPERATOR IDENTITY operator.external
OP AUTH.GREMLIN IDENTITY gremlin.system.root
OP AUTH.AI IDENTITY ai.client
OP AUTH.ORDER ORDER AUTH.OPERATOR AUTH.GREMLIN AUTH.AI
OP AUTH.GREMLIN.SUPERVISION CONDITION AUTH.GREMLIN ACTIVE
OP AUTH.GREMLIN.INTERNAL CONDITION AUTH.GREMLIN INTERNAL_EXECUTION
OP AUTH.EXTERNAL.CAPABILITY CONDITION AUTH.GREMLIN AVAILABLE_CONDITIONAL
OP AUTH.AI.SELF CONDITION AUTH.AI SELF_AUTHORIZATION_FALSE
OP AUTH.AI.OVERRIDE CONDITION AUTH.AI OVERRIDE_GREMLIN_FALSE
OP AUTH.RETURN RETURN AUTH.ORDER
ASSERT AUTH.GREMLIN.SUPERVISION
ASSERT AUTH.GREMLIN.INTERNAL
ASSERT AUTH.EXTERNAL.CAPABILITY
ASSERT AUTH.AI.SELF
ASSERT AUTH.AI.OVERRIDE
EMIT AUTH.RETURN

# AUTHORITY_ORDER OPERATOR>GREMLIN>AI_CLIENT
# GREMLIN_SUPERVISION ACTIVE
# GREMLIN_INTERNAL_EXECUTION ACTIVE
# GREMLIN_INTERNAL_WRITE ACTIVE_BOUNDED
# EXTERNAL_MUTATION_CAPABILITY AVAILABLE_CONDITIONAL
# CANON_PROMOTION_CAPABILITY AVAILABLE_CONDITIONAL
# AI_SELF_AUTHORIZATION FALSE
# AI_OVERRIDE_GREMLIN FALSE
# MCP_SELF_GRANTS_AUTHORITY FALSE
# EXTERNAL_MUTATION_REQUIRES RAPHAEL,CONSTITUTION,TETHER,OPERATOR_ADMISSION
# NEW_PNV_OPCODES 0
