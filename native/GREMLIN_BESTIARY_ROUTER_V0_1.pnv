PNV 1
EPISTEMIC CHYBA
MODE INTERNAL_EXECUTION

# GREMLIN Bestiary parallel research topology v0.1.
# Fast capture is separated from interpretation. OCTOPUS routes admitted RAW
# objects to bounded specialist queues. Specialists emit candidates only;
# GREMLIN remains the aggregate authority and canon promotion is external.

OP BESTIARY.RAW SOURCE gremlin.raw.capture
OP BESTIARY.IDENTITY IDENTITY content_addressed_raw_object
OP HUMMINGBIRD.CAPTURE TRANSFORM BESTIARY.RAW append_only_capture
OP OCTOPUS.ROUTE TRANSFORM HUMMINGBIRD.CAPTURE semantic_route_mask
OP OCTOPUS.FANOUT COMPOSITION OCTOPUS.ROUTE bounded_parallel_fanout

OP SPIDER.WEB TRANSFORM OCTOPUS.FANOUT relation_isomorphism_scan
OP RAVEN.RECALL TRANSFORM OCTOPUS.FANOUT memory_similarity_scan
OP HOUND.TRACK TRANSFORM OCTOPUS.FANOUT contradiction_anomaly_scan
OP MOLE.DIG TRANSFORM OCTOPUS.FANOUT deep_local_derivation_scan
OP OWL.AUDIT TRANSFORM OCTOPUS.FANOUT epistemic_status_scan
OP ANT.COLONY TRANSFORM OCTOPUS.FANOUT bounded_combinatorial_scan
OP MANTIS.PRUNE TRANSFORM OCTOPUS.FANOUT duplicate_dead_branch_prune

OP BESTIARY.JOIN ORDER SPIDER.WEB RAVEN.RECALL HOUND.TRACK MOLE.DIG OWL.AUDIT ANT.COLONY MANTIS.PRUNE
OP BELZEBUB.DEFENSE TRANSFORM BESTIARY.JOIN defensive_candidate_scan
OP GREMLIN.AGGREGATE COMPOSITION BESTIARY.JOIN BELZEBUB.DEFENSE
OP GREMLIN.RESULT.RETURN RETURN GREMLIN.AGGREGATE

ASSERT BESTIARY.IDENTITY
ASSERT HUMMINGBIRD.CAPTURE
ASSERT OCTOPUS.ROUTE
EMIT GREMLIN.RESULT.RETURN

# CAPTURE_FIRST TRUE
# CAPTURE_INTERPRETATION FALSE
# ROUTER OCTOPUS
# SPECIALISTS SPIDER,RAVEN,HOUND,MOLE,OWL,ANT,MANTIS
# DEFENSIVE_SUBSYSTEM BELZEBUB
# ROOT_AUTHORITY GREMLIN
# SPECIALIST_OUTPUT_STATUS CANDIDATE
# CANON_ALLOWED FALSE
# ROUTE_MASK_REQUIRED TRUE
# FANOUT_BOUNDED TRUE
# EVENT_DRIVEN TRUE
# TICK_REQUIRED FALSE
# NO_LAST_WRITER_WINS TRUE
# CONTENT_ADDRESSED TRUE
# KAPPA ln(2)/(24*pi)
# NEW_PNV_OPCODES 0
