PNV 1
EPISTEMIC CHYBA
MODE INTERNAL_EXECUTION

# GREMLIN -> PhaseNav -> prototype -> experiment pipeline v0.1.
# Candidate compilation only. No production execution or canon authority.

OP PIPE.GREMLIN.IDENTITY IDENTITY gremlin.system.root
OP PIPE.CANDIDATE.SOURCE SOURCE GREMLIN_RELATION_CANDIDATE_V0_1
OP PIPE.AUDIT.SOURCE SOURCE BELZEBUB_AUDIT_RECEIPT
OP PIPE.AUDIT.CONDITION CONDITION PIPE.AUDIT.SOURCE candidate_survived_counterexample_audit
OP PIPE.AUDITED.CANDIDATE COMPOSITION PIPE.CANDIDATE.SOURCE PIPE.AUDIT.CONDITION

OP PIPE.PHASENAV.ORDER ORDER PIPE.AUDITED.CANDIDATE explicit_phase_native_relations_only
OP PIPE.PHASENAV.COMPILE TRANSFORM PIPE.PHASENAV.ORDER compile_to_T36_Z36_character_ir
OP PIPE.PHASENAV.CONDITION CONDITION PIPE.PHASENAV.COMPILE canon_false_execution_admitted_false_gcd_reduction_false

OP PIPE.PROTOTYPE.ORDER ORDER PIPE.PHASENAV.CONDITION python_reference_target
OP PIPE.PROTOTYPE.BUILD TRANSFORM PIPE.PROTOTYPE.ORDER deterministic_untrusted_prototype_source
OP PIPE.PROTOTYPE.CONDITION CONDITION PIPE.PROTOTYPE.BUILD sandbox_required_production_runtime_write_false

OP PIPE.EXPERIMENT.ORDER ORDER PIPE.PROTOTYPE.CONDITION reference_conformance_harness
OP PIPE.EXPERIMENT.TEST TRANSFORM PIPE.EXPERIMENT.ORDER ast_whitelist_plus_numeric_reference_tests
OP PIPE.EXPERIMENT.CONDITION CONDITION PIPE.EXPERIMENT.TEST receipt_required_before_validated_prototype_status

OP PIPE.CLIENT.COMPOSE COMPOSITION PIPE.PHASENAV.CONDITION PIPE.PROTOTYPE.CONDITION PIPE.EXPERIMENT.CONDITION
OP PIPE.RETURN RETURN PIPE.CLIENT.COMPOSE

ASSERT PIPE.GREMLIN.IDENTITY
ASSERT PIPE.AUDIT.CONDITION
ASSERT PIPE.PHASENAV.CONDITION
ASSERT PIPE.PROTOTYPE.CONDITION
ASSERT PIPE.EXPERIMENT.CONDITION
EMIT PIPE.RETURN

# PIPELINE SURVIVED_AUDIT->PHASENAV_IR_CANDIDATE->UNTRUSTED_PROTOTYPE->VALIDATED_PROTOTYPE
# VALIDATED_SCOPE REFERENCE_CONFORMANCE_ONLY
# PHASENAV_SPACE T36
# PHASENAV_DUAL_LATTICE Z36
# CHARACTER_KERNEL KCHI_TORUS_CHARACTER_FIELD
# EXPLICIT_RELATION_COMPILATION TRUE
# TEXT_TO_EXECUTION_INFERENCE FALSE
# SANDBOX_REQUIRED TRUE
# PRODUCTION_RUNTIME_WRITE FALSE
# EXECUTION_AUTHORITY FALSE
# CANON_ALLOWED FALSE
# GREMLIN_ROLE CANDIDATE_GENERATOR_AND_AUDITOR
# BELZEBUB_SURVIVAL_REQUIRED TRUE
# PYTHON_ROLE REFERENCE_AND_TEST_HARNESS_ONLY
# STATIC_RUNTIME_FALLBACK FALSE
# NEW_PNV_OPCODES 0
