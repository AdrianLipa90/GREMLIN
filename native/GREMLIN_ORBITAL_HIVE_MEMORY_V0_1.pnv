# GREMLIN_ORBITAL_HIVE_MEMORY_V0_1
# Authority: CANDIDATE_ONLY / SHARED_COGNITION_ONLY
# Runtime promotion requires separate NOEMA admission.

SYSTEM GREMLIN_ORBITAL_HIVE_MEMORY_V0_1

IMPORT GREMLIN_PERSISTENT_MEMORY_V0_4
IMPORT GREMLIN_NATURAL_QUEUE_TAU_V0_4
IMPORT GREMLIN_BESTIARY_MASS_ORBIT_SCHEDULER_V0_2

CONST ORBIT_COUNT = 36
CONST AUTHORITY = SHARED_COGNITION_ONLY
CONST LAST_WRITER_WINS = FALSE
CONST FAIL_CLOSED = TRUE

STATE INFORMATION_RECORD {
    SUBJECT_ID,
    PAYLOAD_HASH,
    PRIORITY,
    ORBIT_INDEX,
    RADIUS,
    SEMANTIC_ANGLE,
    RELATION_PHASE,
    CLOSURE_STATE,
    PROVENANCE,
    DEPENDENCIES,
    CONTRADICTIONS,
    PARENT_RECORD_ID,
    SEAL_RECEIPT,
    AUTHORITY
}

OPERATOR PRIORITY_TO_ORBIT(PRIORITY) {
    REQUIRE FINITE(PRIORITY)
    REQUIRE 0 <= PRIORITY <= 1
    # Higher information priority occupies an inner ring.
    ORBIT_INDEX <- FLOOR((1 - PRIORITY) * ORBIT_COUNT)
    ORBIT_INDEX <- MIN(ORBIT_COUNT - 1, ORBIT_INDEX)
    RADIUS <- ORBIT_INDEX + 1
    RETURN ORBIT_INDEX, RADIUS
}

OPERATOR PHASE_NORMALIZE(PHI) {
    REQUIRE FINITE(PHI)
    RETURN PHI MOD 2PI
}

GATE EVIDENCE_READY
GATE DEPENDENCIES_CLOSED
GATE CONTRADICTION_AUDITED
GATE PROVENANCE_COMPLETE
GATE PHASE_COHERENT

OPERATOR LATCH(RECORD) {
    REQUIRE RECORD.CLOSURE_STATE NOT_IN {DISPUTED, QUARANTINED}
    REQUIRE EVIDENCE_READY
    REQUIRE DEPENDENCIES_CLOSED
    REQUIRE CONTRADICTION_AUDITED
    REQUIRE PROVENANCE_COMPLETE
    REQUIRE PHASE_COHERENT
    REQUIRE RECORD.AUTHORITY == SHARED_COGNITION_ONLY

    SEAL_RECEIPT <- CONTENT_ADDRESS(
        RECORD.PAYLOAD_HASH,
        RECORD.ORBIT_INDEX,
        RECORD.RADIUS,
        RECORD.SEMANTIC_ANGLE,
        RECORD.RELATION_PHASE,
        RECORD.PROVENANCE,
        RECORD.DEPENDENCIES,
        RECORD.AUTHORITY
    )

    APPEND CHILD_RECORD(
        PARENT_RECORD_ID = RECORD.RECORD_ID,
        CLOSURE_STATE = LOCKED,
        SEAL_RECEIPT = SEAL_RECEIPT,
        AUTHORITY = SHARED_COGNITION_ONLY
    )

    RETURN SEAL_RECEIPT
}

OPERATOR DISPUTE(RECORD, CONTRADICTION_REF) {
    REQUIRE NONEMPTY(CONTRADICTION_REF)
    APPEND CHILD_RECORD(
        PARENT_RECORD_ID = RECORD.RECORD_ID,
        CLOSURE_STATE = DISPUTED,
        CONTRADICTIONS += CONTRADICTION_REF,
        CONTRADICTION_AUDITED = FALSE,
        AUTHORITY = SHARED_COGNITION_ONLY
    )
}

INVARIANT SHARED_COGNITION_DOES_NOT_GRANT_AUTHORITY
INVARIANT LOCKED_RECORDS_ARE_IMMUTABLE
INVARIANT HISTORY_IS_APPEND_ONLY
INVARIANT DISPUTED_OR_QUARANTINED_CANNOT_LATCH
INVARIANT EXACT_COORDINATE_IS_BOUND_IN_LATCH_RECEIPT
INVARIANT SEMANTIC_HASH_ANGLE_IS_ADDRESSING_NOT_SEMANTIC_TRUTH
INVARIANT INFORMATION_ORBIT_IS_NOT_WORKER_SPECIES_ORBIT
