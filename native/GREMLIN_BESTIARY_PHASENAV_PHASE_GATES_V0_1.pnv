PNV 1
EPISTEMIC CHYBA
MODE READ_ONLY

# GREMLIN Bestiary PhaseNav Phase Gates v0.1
# Candidate-only 36D phase-gate declaration.
# No new opcode. No semantic-axis invention. No external effect authority.

SYSTEM GREMLIN_BESTIARY_PHASENAV_PHASE_GATES_V0_1

OP BESTIARY.T36.SOURCE SOURCE phase_state_36d
OP BESTIARY.T36.VALID CONDITION BESTIARY.T36.SOURCE exact_36d_finite_torus
OP BESTIARY.PHASE.GATE TRANSFORM BESTIARY.T36.SOURCE deterministic_phase_gate
OP BESTIARY.PHASE.BATCH COMPOSITION BESTIARY.PHASE.GATE same_gate_same_target_batch

OP HUMMINGBIRD.CAPTURE TRANSFORM BESTIARY.T36.SOURCE append_only_capture
OP OCTOPUS.ROUTE TRANSFORM BESTIARY.T36.SOURCE bounded_phase_similarity_route
OP SPIDER.WEB TRANSFORM BESTIARY.T36.SOURCE pairwise_phase_coherence_graph
OP RAVEN.RECALL TRANSFORM BESTIARY.T36.SOURCE phase_similarity_recall
OP HOUND.TRACK TRANSFORM BESTIARY.T36.SOURCE torus_residual_scan
OP MOLE.DIG TRANSFORM BESTIARY.PHASE.GATE local_target_phase_relaxation
OP OWL.AUDIT TRANSFORM BESTIARY.T36.SOURCE claim_evidence_phase_audit
OP ANT.COLONY TRANSFORM BESTIARY.T36.SOURCE bounded_phase_enumeration
OP MANTIS.PRUNE TRANSFORM BESTIARY.T36.SOURCE torus_duplicate_prune
OP FOX.PLAN TRANSFORM BESTIARY.T36.SOURCE geodesic_phase_plan
OP BEAVER.BUILD TRANSFORM BESTIARY.T36.SOURCE circular_candidate_construction
OP BAT.LISTEN TRANSFORM BESTIARY.T36.SOURCE weak_phase_spectral_scan
OP CANARY.WATCH TRANSFORM BESTIARY.T36.SOURCE phase_speed_cusum
OP SERPENT.SENSE TRANSFORM BESTIARY.T36.SOURCE latent_field_taste_temperature
OP CHAMELEON.SKIN TRANSFORM BESTIARY.T36.SOURCE reversible_phase_skin_not_cryptography
OP BELZEBUB.DEFENSE COMPOSITION SPIDER.WEB RAVEN.RECALL HOUND.TRACK MOLE.DIG OWL.AUDIT ANT.COLONY MANTIS.PRUNE FOX.PLAN BEAVER.BUILD BAT.LISTEN CANARY.WATCH SERPENT.SENSE defensive_candidate_synthesis
OP GREMLIN.AGGREGATE COMPOSITION BELZEBUB.DEFENSE verified_head_aggregation_candidate
OP FERRET.ADMIT CONDITION explicit_authorization scope_match receipt_valid

ASSERT BESTIARY.T36.VALID
ASSERT GREMLIN.AGGREGATE
ASSERT FERRET.ADMIT

# AUTHORITY
# CANON_ALLOWED FALSE
# EXTERNAL_EFFECTS FALSE
# PHYSICAL_ANALOG_CLAIM FALSE
# STATIC_RUNTIME_FALLBACK FALSE
