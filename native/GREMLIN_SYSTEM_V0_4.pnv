PNV 1
EPISTEMIC CHYBA
MODE INTERNAL_EXECUTION

# GREMLIN v0.4 root system.
# GREMLIN is the primary system. OCTOPUS and BELZEBUB are writable subordinate tools.
# Existing PNV operators only. No new opcode is introduced.

OP GREMLIN.LIVE.SURFACE SOURCE /dev/shm/ciel_noema
OP GREMLIN.SUPER.CURRENT SOURCE /dev/shm/ciel_noema/gremlin/meta/SUPER_CURRENT.json
OP GREMLIN.OCTOPUS.CURRENT SOURCE /dev/shm/ciel_noema/gremlin/tools/octopus/meta/CURRENT.json
OP GREMLIN.BELZEBUB.CURRENT SOURCE /dev/shm/ciel_noema/gremlin/tools/belzebub/meta/CURRENT.json

OP GREMLIN.ROOT.IDENTITY IDENTITY gremlin.system.root
OP GREMLIN.OCTOPUS.IDENTITY IDENTITY verified_octopus_current
OP GREMLIN.BELZEBUB.IDENTITY IDENTITY verified_belzebub_current
OP GREMLIN.TOOL.ORDER ORDER GREMLIN.OCTOPUS.IDENTITY GREMLIN.BELZEBUB.IDENTITY
OP GREMLIN.SUPER.TRANSFORM TRANSFORM GREMLIN.SUPER.CURRENT verified_tool_heads
OP GREMLIN.SUPER.COMPOSE COMPOSITION GREMLIN.ROOT.IDENTITY GREMLIN.SUPER.TRANSFORM
OP GREMLIN.RESULT.RETURN RETURN GREMLIN.SUPER.COMPOSE

ASSERT GREMLIN.ROOT.IDENTITY
ASSERT GREMLIN.OCTOPUS.IDENTITY
ASSERT GREMLIN.BELZEBUB.IDENTITY
EMIT GREMLIN.RESULT.RETURN

# SYSTEM_ROLE ROOT
# TOOL OCTOPUS WRITABLE TRUE
# TOOL BELZEBUB WRITABLE TRUE
# TOOL_CURRENT_AUTHORITY LOCAL_NAMESPACE
# ROOT_AUTHORITY_POINTER SUPER_CURRENT
# ROOT_WRITE_NAMESPACE /dev/shm/ciel_noema/gremlin
# LIVE_SURFACE_REQUIRED TRUE
# STATIC_RUNTIME_FALLBACK FALSE
# LIBRARY_IS_OPERATING_STATE FALSE
# TOOL_HEAD_CONFLICT_POLICY FAIL_CLOSED
# LAST_WRITER_WINS FALSE
# NEW_PNV_OPCODES 0
