PNV 1
EPISTEMIC CHYBA
MODE INTERNAL_EXECUTION

# GREMLIN_QUANTUM_APPLICATION_ORCHESTRATOR_V0_1
# GREMLIN preserves PhaseNav/PNCS state until named measurement boundaries.

CONTRACT GREMLIN_QUANTUM_APPLICATION_ORCHESTRATOR_V0_1
STATUS CANDIDATE
PNCS_CONTRACT PNCS_QUANTUM_APPLICATION_RUNTIME_V0_31
PHASENAV_CONTRACT PHASENAV_QUANTUM_APPLICATION_STATE_V0_1
EXECUTION LOCAL_FIRST
REMOTE_PROVIDER_REQUIRED FALSE

OP GQ.STATE SOURCE PHASENAV_QUANTUM_APPLICATION_STATE
OP GQ.ROUTE ORDER GQ.STATE geometry_phase_state_scheduler
OP GQ.BESTIARY TRANSFORM GQ.ROUTE preserve_typed_residual_tensor
OP GQ.AGGREGATE COMPOSITION GQ.STATE GQ.BESTIARY
OP GQ.LEASE.ORDER ORDER GQ.AGGREGATE explicit_measurement_M_lease
OP GQ.LEASE TRANSFORM GQ.LEASE.ORDER binary_worker_lease_projection
OP GQ.SAFETY.ORDER ORDER GQ.AGGREGATE explicit_measurement_M_safety
OP GQ.SAFETY TRANSFORM GQ.SAFETY.ORDER fail_closed_constitutional_projection
OP GQ.RELEASE.ORDER ORDER GQ.AGGREGATE explicit_measurement_M_release
OP GQ.RELEASE TRANSFORM GQ.RELEASE.ORDER release_or_quarantine_projection
OP GQ.RETURN RETURN GQ.AGGREGATE

ASSERT GQ.STATE
ASSERT GQ.BESTIARY
ASSERT GQ.LEASE.ORDER
ASSERT GQ.SAFETY.ORDER
ASSERT GQ.RELEASE.ORDER
EMIT GQ.RETURN

# NEVER_COLLAPSE_EARLY TRUE
# RESIDUAL_IS_INFORMATION TRUE
# READY_BOOL_IS_MEASUREMENT TRUE
# PASS_FAIL_INTERNAL_STATE FALSE
# CLASSICAL_BOUNDARY_EXPLICIT TRUE
# LOCAL_EXECUTION_PRIMARY TRUE
# RAILWAY_REQUIRED FALSE
# GITHUB_ACTIONS_REQUIRED FALSE
# PHYSICAL_QUANTUM_CLAIM DEFAULT_FALSE
# PRODUCTION_RUNTIME_WRITE FALSE
# CANON_ALLOWED FALSE
# NEW_PNV_OPCODES 0
