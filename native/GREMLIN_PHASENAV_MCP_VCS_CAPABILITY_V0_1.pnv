PNV 1
EPISTEMIC CHYBA
MODE INTERNAL_EXECUTION

# GREMLIN PhaseNav MCP VCS capability v0.1.
# Native operators only. No new PNV opcode is introduced.
# This surface prepares bounded VCS authority envelopes; it does not self-grant canon authority.

OP VCS.IDENTITY.SOURCE SOURCE current.identity
OP VCS.IDENTITY.VERIFY IDENTITY verified_identity

OP VCS.DOMAIN.SOURCE SOURCE current.domain
OP VCS.DOMAIN.VERIFY IDENTITY verified_domain
OP VCS.DOMAIN.ORDER ORDER VCS.IDENTITY.VERIFY VCS.DOMAIN.VERIFY

OP VCS.AUTHORITY.SOURCE SOURCE current.authority
OP VCS.AUTHORITY.VERIFY IDENTITY verified_authority
OP VCS.AUTHORITY.ORDER ORDER VCS.DOMAIN.ORDER VCS.AUTHORITY.VERIFY

OP VCS.REQUEST.SOURCE SOURCE user.request
OP VCS.ACTION.SOURCE SOURCE phasenav.action_packet_v1
OP VCS.GATE.SOURCE SOURCE operator.gate_receipt
OP VCS.TETHER.SOURCE SOURCE current.tether

OP VCS.PREFLIGHT.COMPOSE COMPOSITION VCS.AUTHORITY.ORDER VCS.ACTION.SOURCE
OP VCS.PREFLIGHT.REQUEST COMPOSITION VCS.PREFLIGHT.COMPOSE VCS.REQUEST.SOURCE
OP VCS.PREFLIGHT.GATE COMPOSITION VCS.PREFLIGHT.REQUEST VCS.GATE.SOURCE
OP VCS.PREFLIGHT.TETHER COMPOSITION VCS.PREFLIGHT.GATE VCS.TETHER.SOURCE
OP VCS.PREFLIGHT.CONDITION CONDITION VCS.PREFLIGHT.TETHER phasenav_vcs_preflight_pass

OP VCS.CHECKPOINT.TRANSFORM TRANSFORM VCS.PREFLIGHT.CONDITION checkpoint_prepare
OP VCS.BRANCH.TRANSFORM TRANSFORM VCS.CHECKPOINT.TRANSFORM candidate_branch_prepare
OP VCS.WRITES.TRANSFORM TRANSFORM VCS.BRANCH.TRANSFORM copy_only_writes_prepare
OP VCS.COMMIT.TRANSFORM TRANSFORM VCS.WRITES.TRANSFORM logical_commit_prepare
OP VCS.TAG.TRANSFORM TRANSFORM VCS.CHECKPOINT.TRANSFORM checkpoint_tag_prepare
OP VCS.BUNDLE.COMPOSE COMPOSITION VCS.TAG.TRANSFORM VCS.BRANCH.TRANSFORM
OP VCS.BUNDLE.TRANSFORM TRANSFORM VCS.BUNDLE.COMPOSE bundle_prepare

OP VCS.NATIVE.EVIDENCE.SOURCE SOURCE phasenav.native_vcs_adapter_evidence
OP VCS.RECEIPT.COMPOSE COMPOSITION VCS.COMMIT.TRANSFORM VCS.NATIVE.EVIDENCE.SOURCE
OP VCS.RECEIPT.CONDITION CONDITION VCS.RECEIPT.COMPOSE native_adapter_verified_shell_false
OP VCS.RECEIPT.RETURN RETURN VCS.RECEIPT.CONDITION

ASSERT VCS.IDENTITY.VERIFY
ASSERT VCS.DOMAIN.VERIFY
ASSERT VCS.AUTHORITY.VERIFY
ASSERT VCS.PREFLIGHT.CONDITION
ASSERT VCS.RECEIPT.CONDITION
EMIT VCS.RECEIPT.RETURN

# ACTION_PACKET_REQUIRED PHASENAV_ACTION_PACKET_V1
# EXECUTION_RECEIPT_REQUIRED PHASENAV_EXECUTION_RECEIPT_V1
# GREMLIN_TRIPLE_PULSE_REQUIRED TRUE
# SAME_GENERATION_BINDING REQUIRED
# TETHER_GUARD_REQUIRED TRUE
# COPY_ONLY TRUE
# DIRECT_MAIN_MUTATION FALSE
# DELETE_MOVE_RENAME FALSE
# CHECKPOINT_REQUIRED TRUE
# TAG_REQUIRED TRUE
# BUNDLE_REQUIRED TRUE
# TEST_RECEIPT_REQUIRED TRUE
# NATIVE_VCS_ADAPTER_REQUIRED TRUE
# SHELL_USED FALSE
# GIT_CLI_ALLOWED FALSE
# SUBPROCESS_ALLOWED FALSE
# CANON_ALLOWED FALSE
# PRODUCTION_RUNTIME_WRITE FALSE
# FAIL_CLOSED TRUE
# NEW_PNV_OPCODES 0
