PNV 1
EPISTEMIC CHYBA
MODE INTERNAL_EXECUTION

# RAPHAEL — Lord of Wisdom / wisdom-governed mutation.
# RAPHAEL is an ANGELIC_FUNCTION above GREMLIN SUPER_CURRENT, not a Bestiary species.
# Existing Bestiary PhaseNav species geometry remains unchanged.

OP RAPHAEL.IDENTITY IDENTITY gremlin.angelic.raphael
OP RAPHAEL.EYE.SOURCE SOURCE GREMLIN_SUPER_CURRENT
OP RAPHAEL.EYE.EVIDENCE SOURCE GREMLIN_OWL_HOUND_RECEIPTS
OP RAPHAEL.EYE.CONDITION CONDITION RAPHAEL.EYE.EVIDENCE provenance_complete_contradiction_audited_target_state_exact

OP RAPHAEL.WORD.ORDER ORDER RAPHAEL.EYE.CONDITION exact_scope_before_mutation
OP RAPHAEL.WORD.DECREE TRANSFORM RAPHAEL.WORD.ORDER immutable_mutation_decree_blake2b256
OP RAPHAEL.WORD.CONDITION CONDITION RAPHAEL.WORD.DECREE external_authorization_required_single_use

OP RAPHAEL.HAND.AUTHORITY SOURCE EXTERNAL_MUTATION_AUTHORIZATION_RECEIPT
OP RAPHAEL.HAND.TETHER SOURCE LIVE_TETHER_GUARD
OP RAPHAEL.HAND.TRIPLEPULSE SOURCE GREMLIN_TRIPLE_PULSE_ATTESTATION_V0_1
OP RAPHAEL.HAND.ADMISSION COMPOSITION RAPHAEL.HAND.AUTHORITY RAPHAEL.HAND.TETHER RAPHAEL.HAND.TRIPLEPULSE
OP RAPHAEL.HAND.CONDITION CONDITION RAPHAEL.HAND.ADMISSION exact_decree_exact_target_active_tether_same_generation
OP RAPHAEL.HAND.BIND COMPOSITION RAPHAEL.WORD.CONDITION RAPHAEL.HAND.CONDITION
OP RAPHAEL.HAND.RESERVE TRANSFORM RAPHAEL.HAND.BIND atomic_exact_target_scope_reservation
OP RAPHAEL.HAND.RESERVE.CONDITION CONDITION RAPHAEL.HAND.RESERVE prepared_target_scope_match_rollback_state_bound
OP RAPHAEL.HAND.MUTATE TRANSFORM RAPHAEL.HAND.RESERVE.CONDITION exact_declared_operations_only

OP RAPHAEL.POSTAUDIT.TEST TRANSFORM RAPHAEL.HAND.MUTATE required_tests_and_postconditions
OP RAPHAEL.POSTAUDIT.CONDITION CONDITION RAPHAEL.POSTAUDIT.TEST rollback_or_quarantine_on_failure
OP RAPHAEL.RECEIPT RETURN RAPHAEL.POSTAUDIT.CONDITION

ASSERT RAPHAEL.IDENTITY
ASSERT RAPHAEL.EYE.CONDITION
ASSERT RAPHAEL.WORD.CONDITION
ASSERT RAPHAEL.HAND.CONDITION
ASSERT RAPHAEL.HAND.RESERVE.CONDITION
ASSERT RAPHAEL.POSTAUDIT.CONDITION
EMIT RAPHAEL.RECEIPT

# CLASS ANGELIC_FUNCTION
# TITLE LORD_OF_WISDOM
# PIPELINE EYE->WORD->EXTERNAL_AUTHORITY_GATE->LIVE_ADMISSION->HAND_RESERVE->HAND_MUTATE->POST_AUDIT
# BESTIARY_SPECIES FALSE
# GREMLIN_SUPER_CURRENT_INPUT TRUE
# REQUIRED_WISDOM_PRODUCERS GREMLIN,OWL,HOUND
# MANDATORY_WISDOM_QUORUM_CALLER_WEAKENING FALSE
# POST_AUDIT_GATE_RESULT_TYPE EXACT_BOOLEAN
# POST_CONSUMPTION_CANCELLATION FALSE
# SINGLE_USE_LEDGER_ATOMIC_IN_PROCESS TRUE
# BACKEND_RECEIPT_FINITE_CANONICAL_JSON REQUIRED
# OPERATION_FIELD_SCHEMA EXACT_FAIL_CLOSED
# UPDATE_DELETE_MOVE_EXPECTED_BLOB_SHA REQUIRED
# ACCEPT_REQUIRED_TEST_COUNT_MIN 1
# ACCEPT_POSTCONDITION_COUNT_MIN 1
# EPISTEMIC CHYBA
# DECISIONS ACCEPT,REJECT,DEFER,REQUIRE_MORE_EVIDENCE
# DECREE_COMMITMENT BLAKE2B_256
# MUTATION_SCOPE EXACT_DECREE_ONLY
# EXTERNAL_AUTHORIZATION REQUIRED
# OPERATOR_GATE_RECEIPT REQUIRED
# LIVE_TETHER_STATUS ACTIVE
# GREMLIN_TRIPLE_PULSE_ATTESTATION REQUIRED
# SAME_GENERATION_IDENTITY_DOMAIN_AUTHORITY REQUIRED
# LIVE_ADMISSION_REPROBE_BEFORE_HAND REQUIRED
# EXACT_STATE_RESERVATION REQUIRED
# RESERVATION_COMMITMENT BLAKE2B_256
# SINGLE_USE TRUE
# STATE_DRIFT FAIL_CLOSED
# UNDECLARED_PATH FORBIDDEN
# UNDECLARED_OPERATION FORBIDDEN
# NO_SILENT_RECOVERY TRUE
# ROLLBACK_OR_QUARANTINE TRUE
# MUTATION_AUTHORITY_EXPIRES_AFTER_RECEIPT TRUE
# PRODUCTION_RUNTIME_WRITE FALSE
# EXECUTION_AUTHORITY FALSE
# CANON_ALLOWED FALSE
# TARGET_MUTATION_REQUIRES_EXPLICIT_ADMISSION TRUE
# NEW_PNV_OPCODES 0
