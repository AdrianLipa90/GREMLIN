PNV 1
EPISTEMIC CHYBA
MODE INTERNAL_EXECUTION

# GREMLIN MCP native admission v0.6.
# PNV is the policy authority. Host code supplies typed observed facts only.
# No callback-dependent CONDITION or TRANSFORM is admitted in this gate.

OP MCP.IDENTITY.STATUS SOURCE current.identity_status
OP MCP.IDENTITY.OK IDENTITY MCP.IDENTITY.STATUS VERIFIED

OP MCP.DOMAIN.STATUS SOURCE current.domain_status
OP MCP.DOMAIN.OK IDENTITY MCP.DOMAIN.STATUS ACTIVE

OP MCP.AUTHORITY.STATUS SOURCE current.authority_status
OP MCP.AUTHORITY.OK IDENTITY MCP.AUTHORITY.STATUS VERIFIED

OP MCP.TETHER.STATUS SOURCE current.tether_status
OP MCP.TETHER.OK IDENTITY MCP.TETHER.STATUS ACTIVE

OP MCP.GUARD.STATUS SOURCE current.guard_status
OP MCP.GUARD.OK IDENTITY MCP.GUARD.STATUS ACTIVE
OP MCP.GUARD.FAILURES SOURCE current.guard_failures_count
OP MCP.GUARD.FAILURES.OK IDENTITY MCP.GUARD.FAILURES 0

OP MCP.GENERATION.ROOT SOURCE current.generation
OP MCP.GENERATION.IDENTITY SOURCE current.identity_generation
OP MCP.GENERATION.DOMAIN SOURCE current.domain_generation
OP MCP.GENERATION.AUTHORITY SOURCE current.authority_generation
OP MCP.GENERATION.IDENTITY.OK IDENTITY MCP.GENERATION.IDENTITY MCP.GENERATION.ROOT
OP MCP.GENERATION.DOMAIN.OK IDENTITY MCP.GENERATION.DOMAIN MCP.GENERATION.ROOT
OP MCP.GENERATION.AUTHORITY.OK IDENTITY MCP.GENERATION.AUTHORITY MCP.GENERATION.ROOT

OP MCP.SYNC.STATUS SOURCE current.system_sync_status
OP MCP.SYNC.OK IDENTITY MCP.SYNC.STATUS ALIGNED_CANDIDATE
OP MCP.SYNC.GENERATION SOURCE current.system_sync_generation
OP MCP.SYNC.GENERATION.OK IDENTITY MCP.SYNC.GENERATION MCP.GENERATION.ROOT
# Request facts must be explicitly materialized before ORDER and ASSERT.
OP MCP.REQUEST.KEY_MUTATION SOURCE request.key_mutation
OP MCP.REQUEST.KEY_MUTATION.OK IDENTITY MCP.REQUEST.KEY_MUTATION FALSE
OP MCP.REQUEST.PRODUCTION_EFFECT SOURCE request.production_effect
OP MCP.REQUEST.PRODUCTION_EFFECT.OK IDENTITY MCP.REQUEST.PRODUCTION_EFFECT FALSE

OP MCP.ADMISSION.ORDER ORDER MCP.IDENTITY.OK MCP.DOMAIN.OK MCP.AUTHORITY.OK MCP.TETHER.OK MCP.GUARD.OK MCP.GUARD.FAILURES.OK MCP.GENERATION.IDENTITY.OK MCP.GENERATION.DOMAIN.OK MCP.GENERATION.AUTHORITY.OK MCP.SYNC.OK MCP.SYNC.GENERATION.OK MCP.REQUEST.KEY_MUTATION.OK MCP.REQUEST.PRODUCTION_EFFECT.OK
OP MCP.ADMISSION.COMPOSE COMPOSITION MCP.ADMISSION.ORDER
OP MCP.ADMISSION.RETURN RETURN MCP.ADMISSION.COMPOSE

ASSERT MCP.IDENTITY.OK
ASSERT MCP.DOMAIN.OK
ASSERT MCP.AUTHORITY.OK
ASSERT MCP.TETHER.OK
ASSERT MCP.GUARD.OK
ASSERT MCP.GUARD.FAILURES.OK
ASSERT MCP.GENERATION.IDENTITY.OK
ASSERT MCP.GENERATION.DOMAIN.OK
ASSERT MCP.GENERATION.AUTHORITY.OK
ASSERT MCP.SYNC.OK
ASSERT MCP.SYNC.GENERATION.OK
ASSERT MCP.REQUEST.KEY_MUTATION.OK
ASSERT MCP.REQUEST.PRODUCTION_EFFECT.OK
EMIT MCP.ADMISSION.RETURN

# MUTATION_TIER_READ_ONLY READ_ONLY
# MUTATION_TIER_LOW_RISK_AUTO LOW_RISK_AUTO
# MUTATION_TIER_KEY_REVIEW KEY_MUTATION_REVIEW
# LOCAL_STATE_AUTO TRUE
# MAIN_MUTATION_AUTO FALSE
# CANON_PROMOTION_GATED_HERE FALSE
# DELETE_MOVE_RENAME_AUTO FALSE
# FORCE_PUSH_AUTO FALSE
# SECRETS_AUTO FALSE
# PRODUCTION_EFFECT_AUTO FALSE
# SAME_GENERATION_REQUIRED TRUE
# ACTIVE_TETHER_REQUIRED TRUE
# TRIPLE_PULSE_REQUIRED TRUE
# SYSTEM_SYNC_REQUIRED TRUE
# SYSTEM_SYNC_SAME_GENERATION_REQUIRED TRUE
# FAIL_CLOSED TRUE
# NEW_PNV_OPCODES 0
