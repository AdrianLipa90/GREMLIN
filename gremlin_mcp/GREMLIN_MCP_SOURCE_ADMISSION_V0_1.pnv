PNV 1
EPISTEMIC CHYBA
MODE INTERNAL_EXECUTION

# GREMLIN MCP source-work admission v0.1.
# This lane governs candidate/source/read-only/internal bounded work.
# It deliberately does not require a live NOEMA tether because it cannot
# grant canon promotion or a production effect.

OP MCP.REQUEST.KNOWN SOURCE request.known_tool
OP MCP.REQUEST.KNOWN.OK IDENTITY MCP.REQUEST.KNOWN TRUE

OP MCP.REQUEST.POLICY SOURCE request.policy_admitted
OP MCP.REQUEST.POLICY.OK IDENTITY MCP.REQUEST.POLICY TRUE

OP MCP.REQUEST.KEY_MUTATION SOURCE request.key_mutation
OP MCP.REQUEST.KEY_MUTATION.OK IDENTITY MCP.REQUEST.KEY_MUTATION FALSE

OP MCP.REQUEST.CANON_MUTATION SOURCE request.canon_mutation
OP MCP.REQUEST.CANON_MUTATION.OK IDENTITY MCP.REQUEST.CANON_MUTATION FALSE

OP MCP.REQUEST.PRODUCTION_EFFECT SOURCE request.production_effect
OP MCP.REQUEST.PRODUCTION_EFFECT.OK IDENTITY MCP.REQUEST.PRODUCTION_EFFECT FALSE

OP MCP.REQUEST.SCOPE_EXACT SOURCE request.scope_exact
OP MCP.REQUEST.SCOPE_EXACT.OK IDENTITY MCP.REQUEST.SCOPE_EXACT TRUE

OP MCP.SOURCE.ADMISSION.ORDER ORDER MCP.REQUEST.KNOWN.OK MCP.REQUEST.POLICY.OK MCP.REQUEST.KEY_MUTATION.OK MCP.REQUEST.CANON_MUTATION.OK MCP.REQUEST.PRODUCTION_EFFECT.OK MCP.REQUEST.SCOPE_EXACT.OK
OP MCP.SOURCE.ADMISSION.COMPOSE COMPOSITION MCP.SOURCE.ADMISSION.ORDER
OP MCP.SOURCE.ADMISSION.RETURN RETURN MCP.SOURCE.ADMISSION.COMPOSE

ASSERT MCP.REQUEST.KNOWN.OK
ASSERT MCP.REQUEST.POLICY.OK
ASSERT MCP.REQUEST.KEY_MUTATION.OK
ASSERT MCP.REQUEST.CANON_MUTATION.OK
ASSERT MCP.REQUEST.PRODUCTION_EFFECT.OK
ASSERT MCP.REQUEST.SCOPE_EXACT.OK
EMIT MCP.SOURCE.ADMISSION.RETURN

