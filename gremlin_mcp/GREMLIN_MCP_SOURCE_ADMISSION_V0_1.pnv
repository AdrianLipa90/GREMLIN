PNV 1
EPISTEMIC CHYBA
MODE INTERNAL_EXECUTION

# GREMLIN MCP source-work admission v0.2.
# Source/internal work is separate from live-production admission.
# This lane does not require live NOEMA tether because it does not itself
# produce an external production effect. Tool metadata is descriptive,
# not an authority whitelist, and canon capability is not denied here.

OP MCP.REQUEST.KEY_MUTATION SOURCE request.key_mutation
OP MCP.REQUEST.KEY_MUTATION.OK IDENTITY MCP.REQUEST.KEY_MUTATION FALSE

OP MCP.REQUEST.PRODUCTION_EFFECT SOURCE request.production_effect
OP MCP.REQUEST.PRODUCTION_EFFECT.OK IDENTITY MCP.REQUEST.PRODUCTION_EFFECT FALSE

OP MCP.SOURCE.ADMISSION.ORDER ORDER MCP.REQUEST.KEY_MUTATION.OK MCP.REQUEST.PRODUCTION_EFFECT.OK
OP MCP.SOURCE.ADMISSION.COMPOSE COMPOSITION MCP.SOURCE.ADMISSION.ORDER
OP MCP.SOURCE.ADMISSION.RETURN RETURN MCP.SOURCE.ADMISSION.COMPOSE

ASSERT MCP.REQUEST.KEY_MUTATION.OK
ASSERT MCP.REQUEST.PRODUCTION_EFFECT.OK
EMIT MCP.SOURCE.ADMISSION.RETURN

# AUTHORITY_LANE SOURCE_WORK
# SOURCE_WORK_AUTHORITY ACTIVE
# LIVE_TETHER_REQUIRED FALSE
# TOOL_WHITELIST NONE
# CANON_PROMOTION_GATED_HERE FALSE
# PRODUCTION_EFFECT_AUTO FALSE
# KEY_MUTATION_AUTO FALSE
# NEW_PNV_OPCODES 0
