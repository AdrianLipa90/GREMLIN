# GREMLIN × OpenAI Secure MCP Tunnel v0.1
# Copy values into your secure environment. Do not commit real secrets.

GREMLIN_OPENAI_TUNNEL_ID=tunnel_REPLACE_ME
CONTROL_PLANE_API_KEY=REPLACE_VIA_SECURE_SECRET_STORE

# Optional durable state overrides. If omitted, gremlin-openai-tunnel
# uses ~/.local/state/gremlin/{worker,hive}.sqlite3.
# GREMLIN_MCP_STATE_PATH=/absolute/private/path/worker.sqlite3
# GREMLIN_HIVE_STATE_PATH=/absolute/private/path/hive.sqlite3
