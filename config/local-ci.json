{
  "schema": "GREMLIN_LOCAL_CI_PROXY_CONFIG_V0_1",
  "listen_host": "127.0.0.1",
  "listen_port": 8765,
  "receipt_dir": "~/.gremlin/local-ci/receipts",
  "work_dir": "~/.gremlin/local-ci/work",
  "allowed_roots": [],
  "profiles": {
    "gremlin-pytest-current": {
      "fail_fast": true,
      "timeout_seconds": 1800,
      "commands": [
        {
          "name": "compileall",
          "argv": ["python3", "-m", "compileall", "-q", "gremlin_mcp", "tests", "tools"]
        },
        {
          "name": "pytest",
          "argv": ["python3", "-m", "pytest", "-q"]
        }
      ]
    },
    "gremlin-redteam-current": {
      "fail_fast": true,
      "timeout_seconds": 1800,
      "commands": [
        {
          "name": "compileall-redteam",
          "argv": ["python3", "-m", "compileall", "-q", "gremlin_mcp", "tests/redteam"]
        },
        {
          "name": "pytest-redteam",
          "argv": ["python3", "-m", "pytest", "-q", "tests/redteam"]
        }
      ]
    }
  }
}
